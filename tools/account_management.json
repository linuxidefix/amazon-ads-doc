                        "ASIA_HONG_KONG",
                        "ASIA_KABUL",
                        "ASIA_KATHMANDU",
                        "ASIA_KOLKATA",
                        "ASIA_MAGADAN",
                        "ASIA_RIYADH",
                        "ASIA_SHANGHAI",
                        "ASIA_SINGAPORE",
                        "ASIA_TEHRAN",
                        "ASIA_TOKYO",
                        "ASIA_YEKATERINBURG",
                        "ASIA_YEREVAN",
                        "ATLANTIC_AZORES",
                        "ATLANTIC_SOUTH_GEORGIA",
                        "AUSTRALIA_BRISBANE",
                        "AUSTRALIA_DARWIN",
                        "AUSTRALIA_SYDNEY",
                        "EET",
                        "EUROPE_AMSTERDAM",
                        "EUROPE_ISTANBUL",
                        "EUROPE_LONDON",
                        "EUROPE_PARIS",
                        "EUROPE_STOCKHOLM",
                        "INDIAN_COCOS",
                        "PACIFIC_AUCKLAND",
                        "PACIFIC_FIJI",
                        "PACIFIC_HONOLULU",
                        "PACIFIC_KWAJALEIN",
                        "PACIFIC_MIDWAY"
                      ]
                    }
                  },
                  "required": [
                    "businessDetails"
                  ]
                }
              }
            }
          }
        }
