            "properties": {
              "advertiserAccounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "businessDetails": {
                      "type": "array",
                      "description": "The business details for an advertising account, containing either an address token for sellingAccount, or an address object if the sellingAccount lacks a valid address.",
                      "items": {
                        "type": "object",
                        "description": "The business details of advertising account.",
                        "properties": {
                          "address": {
                            "type": "object",
                            "description": "The business address of advertising account.",
                            "properties": {
                              "addressLine1": {
                                "type": "string",
                                "description": "Primary street address of the business."
                              },
                              "addressLine2": {
                                "type": "string",
                                "description": "Secondary address line (suite, unit, etc.)."
                              },
                              "businessName": {
                                "type": "string",
                                "description": "The name of business."
                              },
                              "city": {
                                "type": "string",
                                "description": "The city where business is located."
                              },
                              "countryCode": {
                                "type": "string",
                                "description": "ISO 3166-1 alpha-2 country code (e.g. \"US\", \"GB\", \"DE\")."
                              },
                              "phoneNumber": {
                                "type": "string",
                                "description": "Business phone number."
                              },
                              "state": {
                                "type": "string",
                                "description": "The state or subdivision where the business is located. Validated against CLDR subdivision names for the given countryCode."
                              },
                              "zipCode": {
                                "type": "string",
                                "description": "The zipCode where business is located."
                              }
                            },
                            "required": [
                              "addressLine1",
                              "businessName",
                              "city",
                              "countryCode",
                              "phoneNumber"
                            ]
                          },
                          "addressToken": {
                            "type": "string",
                            "description": "The token of the business address being linked."
                          },
                          "businessRegistrationNumber": {
                            "type": "string",
                            "description": "The business registration number of the business."
                          },
                          "website": {
                            "type": "string",
                            "description": "Business website URL."
                          }
                        }
                      }
                    },
                    "currencyCode": {
                      "type": "string",
                      "enum": [
                        "AED",
                        "AUD",
                        "BRL",
                        "CAD",
                        "CHF",
                        "CNY",
                        "DKK",
