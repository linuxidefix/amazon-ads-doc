{
  "openapi": "3.0.0",
  "info": {
    "title": "account_management",
    "description": "MCP tools related to account_management",
    "version": "v1"
  },
  "paths": {
    "/mcp/update_account_currency": {
      "post": {
        "operationId": "update_account_currency",
        "description": "Update the currency code of an advertiser account.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/update_account_currencyInputSchema"
              }
            }
          }
        },
        "tags": [
          "account_management"
        ]
      }
    },
    "/mcp/update_account_timezone": {
      "post": {
        "operationId": "update_account_timezone",
        "description": "Update the timezone of an advertiser account.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/update_account_timezoneInputSchema"
              }
            }
          }
        },
        "tags": [
          "account_management"
        ]
      }
    },
    "/mcp/update_account_name": {
      "post": {
        "operationId": "update_account_name",
        "description": "Update the display name of an advertiser account.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/update_account_nameInputSchema"
              }
            }
          }
        },
        "tags": [
          "account_management"
        ]
      }
    },
    "/mcp/query_advertiser_account": {
      "post": {
        "operationId": "query_advertiser_account",
        "description": "List or query advertiser accounts the user has access to. Without filters, returns global accounts. Use `isGlobalAccountFilter: { include: [true] }` for global or `{ include: [false] }` for non-global accounts. Use `advertiserAccountIdFilter` to query specific global accounts by ID (e.g. `amzn1.ads-account.g.XXXXX`). Returns `alternateIds` containing DSP advertiser IDs (`dspAdvertiserId`), Sponsored Ads profile IDs (`profileId`), entity IDs (`entityId`), and marketplace country codes (`countryCode`). Preferred tool for \"which accounts do I have access to?\" questions.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/query_advertiser_accountInputSchema"
              }
            }
          }
        },
        "tags": [
          "account_management"
        ]
      }
    },
    "/mcp/query_account_link": {
      "post": {
        "operationId": "query_account_link",
        "description": "Query account links. Manager Account users can retrieve details about all accounts linked to their Manager Accounts. Additionally, advertiser account users can find all Manager Accounts linked to their advertising account.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/query_account_linkInputSchema"
              }
            }
          }
        },
        "tags": [
          "account_management"
        ]
      }
    },
    "/mcp/create_advertiser_account": {
      "post": {
        "operationId": "create_advertiser_account",
        "description": "Create a new advertiser account (Global Account). Returns an advertiserAccountId in the format amzn1.ads-account.g.*. The account starts in REGISTRATION_IN_PROGRESS status. Requires businessDetails with a valid address.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/create_advertiser_accountInputSchema"
              }
            }
          }
        },
        "tags": [
          "account_management"
        ]
      }
    },
    "/mcp/update_advertiser_account": {
      "post": {
        "operationId": "update_advertiser_account",
        "description": "Update an advertiser account.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/update_advertiser_accountInputSchema"
              }
            }
          }
        },
        "tags": [
          "account_management"
        ]
      }
    }
  },
