                        "ZAR"
                      ]
                    },
                    "displayName": {
                      "type": "string",
                      "description": "Display name for the advertiser account."
                    },
                    "industry": {
                      "type": "string",
                      "enum": [
                        "AMS_KEYWORD",
                        "AMS_SELF_SERVICE",
                        "AUTOMOTIVE",
                        "CONSUMER_GOODS",
                        "ECOMMERCE",
                        "ENTERTAINMENT",
                        "FINANCIAL_SERVICES",
                        "HARDWARE_AND_ELECTRONICS",
                        "HEALTH",
                        "HOUSE_ADS",
                        "PUBLIC_SERVICES",
                        "REMNANT_NETWORKS",
                        "RETAIL_GOODS_AND_SERVICES",
                        "SOFTWARE",
                        "TELECOMMUNICATIONS",
                        "TRAVEL",
                        "TWITCH",
                        "TWITCH_TV",
                        "WEB_MEDIA"
                      ]
                    },
                    "isGlobalAccount": {
                      "type": "boolean",
                      "description": "Indicates whether the advertising account is global or not."
                    },
                    "isTestAccount": {
                      "type": "boolean",
                      "description": "Indicates whether the advertising account is a test account or not."
                    },
                    "managerAccountId": {
                      "type": "string",
                      "description": "Optional. The ID of the manager (parent) account to link the new advertiser account to."
                    },
                    "sellingAccountLinkRequests": {
                      "type": "array",
                      "description": "The selling account link requests for an advertiser account, containing details for linking.",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "emailForApprovalDetails": {
                                "type": "object",
                                "properties": {
                                  "emailForApproval": {
                                    "type": "string",
                                    "description": "The email address associated with the account you want to link to."
                                  },
                                  "sellingProgram": {
                                    "type": "string",
                                    "enum": [
                                      "AMAZON_AUTHOR",
                                      "AMAZON_SELLER",
                                      "AMAZON_VENDOR"
                                    ]
                                  }
                                },
                                "required": [
                                  "emailForApproval",
                                  "sellingProgram"
                                ]
                              }
                            },
                            "required": [
                              "emailForApprovalDetails"
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "sellingAccountLinkDetails": {
                                "type": "object",
                                "properties": {
                                  "sellingAccountLinkToken": {
                                    "type": "string",
                                    "description": "The token to locate a selling account to be linked."
                                  },
                                  "sellingProgram": {
                                    "type": "string",
                                    "enum": [
                                      "AMAZON_AUTHOR",
                                      "AMAZON_SELLER",
                                      "AMAZON_VENDOR"
                                    ]
                                  }
                                },
                                "required": [
                                  "sellingAccountLinkToken"
                                ]
                              }
                            },
                            "required": [
                              "sellingAccountLinkDetails"
                            ]
                          }
                        ]
                      }
                    },
                    "timeZone": {
                      "type": "string",
                      "description": "Each complies with the ISO 8601 TZ identifier standard",
                      "enum": [
                        "AMERICA_ANCHORAGE",
                        "AMERICA_CARACAS",
                        "AMERICA_CHICAGO",
                        "AMERICA_DENVER",
                        "AMERICA_HALIFAX",
                        "AMERICA_LOS_ANGELES",
                        "AMERICA_MEXICO_CITY",
