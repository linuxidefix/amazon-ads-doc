{
  "openapi": "3.0.0",
  "info": {
    "title": "amc",
    "description": "MCP tools related to amc",
    "version": "v1"
  },
  "paths": {
    "/mcp/get_workflows": {
      "post": {
        "operationId": "get_workflows",
        "description": "Returns a list of Amazon Marketing Cloud (AMC) workflows for the given instance and AMC Account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_workflowsInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/get_data_sources": {
      "post": {
        "operationId": "get_data_sources",
        "description": "Returns a list of Amazon Marketing Cloud (AMC) data sources for a given instance and AMC Account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_data_sourcesInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/delete_workflow": {
      "post": {
        "operationId": "delete_workflow",
        "description": "Deletes the specified Amazon Marketing Cloud (AMC) workflow by id. Workflows are defined as a set of operations that take previously defined data sources as input and use them to generate reports.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/delete_workflowInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/get_workflow": {
      "post": {
        "operationId": "get_workflow",
        "description": "Gets the requested Amazon Marketing Cloud (AMC) workflow by id. Workflows are defined as a set of operations that take previously defined data sources as input and use them to generate reports.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_workflowInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/create_workflow": {
      "post": {
        "operationId": "create_workflow",
        "description": "Creates a new Amazon Marketing Cloud (AMC) workflow that can be used to generate reports.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/create_workflowInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/get_data_source": {
      "post": {
        "operationId": "get_data_source",
        "description": "Gets the requested Amazon Marketing Cloud (AMC) data source by id. Data sources can be used as input for reporting workflows. Each data source has a flat schema consisting of a list of columns that each have a name, a data type, and a column typeof metric or dimension.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_data_sourceInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/get_workflow_execution_download_url": {
      "post": {
        "operationId": "get_workflow_execution_download_url",
        "description": "Retrieves pre-signed url for downloading Amazon Marketing Cloud (AMC) workflow execution results from S3",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_workflow_execution_download_urlInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/execute_query": {
      "post": {
        "operationId": "execute_query",
        "description": "Executes an ad-hoc SQL query on Amazon Marketing Cloud (AMC) without requiring a pre-existing workflow.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/execute_queryInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/execute_workflow": {
      "post": {
        "operationId": "execute_workflow",
        "description": "Creates a new, ad-hoc execution of an existing Amazon Marketing Cloud (AMC) workflow",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/execute_workflowInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    },
    "/mcp/get_workflow_execution_status": {
      "post": {
        "operationId": "get_workflow_execution_status",
        "description": "Gets status information about the requested Amazon Marketing Cloud (AMC) workflow execution",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_workflow_execution_statusInputSchema"
              }
            }
          }
        },
        "tags": [
          "amc"
        ]
      }
    }
  },
